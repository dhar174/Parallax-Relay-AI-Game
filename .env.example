# Local configuration only. Never commit the populated .env or paste keys in chat.
# Existing process environment values take precedence over this file.
# Obtain OpenAI credentials through the secure OpenAI Platform setup flow.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Use bare model IDs that your accounts can access and that support images and
# native JSON-schema structured outputs. Models are deliberately not hardcoded.
OPENAI_MODEL=
ANTHROPIC_MODEL=
GEMINI_MODEL=
